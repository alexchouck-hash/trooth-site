---
import Layout from '../../layouts/Layout.astro';
import fs from 'node:fs';
import path from 'node:path';

const scorecardsDir = path.resolve('./public/scorecards');
let sources = [];

if (fs.existsSync(scorecardsDir)) {
  const files = fs.readdirSync(scorecardsDir).filter(f => f.endsWith('.json') && f !== 'manifest.json');
  sources = files.map(file => {
    return JSON.parse(fs.readFileSync(path.join(scorecardsDir, file), 'utf-8'));
  });
}

// Meta lookup for tags and role
const metaInfo = {
  "nws": { role: "Primary", domain: "Weather", license: "Public Domain (17 U.S.C. 105)" },
  "open-meteo": { role: "Derivative", domain: "Weather", license: "CC-BY-4.0" },
  "usgs-earthquake": { role: "Primary", domain: "Geophysics", license: "Public Domain" },
  "bls": { role: "Primary", domain: "Economics", license: "Public Domain" },
  "fred": { role: "Derivative", domain: "Economics", license: "Public Domain Upstream" }
};
---

<Layout title="Public Source Scorecards" activeNav="scorecards">
  <div style="margin-bottom: 3rem;">
    <div style="display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 1rem; margin-bottom: 0.5rem;">
      <h1 style="font-size: 2.25rem; font-weight: 800; letter-spacing: -0.02em;">
        Public Source Scorecards
      </h1>
      <span class="badge badge-blue">Methodology v0.1</span>
    </div>
    <p style="color: var(--text-muted); font-size: 1.1rem; max-width: 800px;">
      Mechanical, un-sponsored evaluations of data feeds across six objective dimensions. Scores are recomputed on a schedule from immutable snapshot history.
    </p>
  </div>

  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.5rem; margin-bottom: 4rem;">
    {sources.map(s => {
      const info = metaInfo[s.source_id] || { role: "Source", domain: "Data", license: "Public" };
      const dims = s.dimensions;
      const isPrimary = info.role === "Primary";

      return (
        <div class="card" style="display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
              <div style="display: flex; gap: 0.5rem;">
                <span class={isPrimary ? "badge badge-green" : "badge badge-amber"}>{info.role}</span>
                <span class="badge">{info.domain}</span>
              </div>
              <span style="font-size: 0.75rem; color: var(--text-subtle);">{info.license}</span>
            </div>

            <h2 style="font-size: 1.35rem; font-weight: 700; margin-bottom: 0.5rem;">
              <a href={`/scorecards/${s.source_id}`} style="text-decoration: none; color: var(--text-main);">
                {s.source_name}
              </a>
            </h2>
            <div style="font-family: var(--font-mono); font-size: 0.8rem; color: var(--primary); margin-bottom: 1rem;">
              source_id: {s.source_id}
            </div>

            <div style="background-color: var(--bg-surface); border: 1px solid var(--border); border-radius: 8px; padding: 0.85rem; margin-bottom: 1.25rem;">
              <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
                <div>
                  <div style="font-size: 0.72rem; color: var(--text-subtle); text-transform: uppercase;">Freshness Lag (p50)</div>
                  <div style="font-size: 1.15rem; font-weight: 700; color: var(--text-main);">{dims.freshness_lag.p50_seconds}s</div>
                </div>
                <div>
                  <div style="font-size: 0.72rem; color: var(--text-subtle); text-transform: uppercase;">Tail Lag (p95)</div>
                  <div style="font-size: 1.15rem; font-weight: 700; color: var(--text-main);">{dims.freshness_lag.p95_seconds}s</div>
                </div>
                <div>
                  <div style="font-size: 0.72rem; color: var(--text-subtle); text-transform: uppercase;">Revision Rate</div>
                  <div style="font-size: 1.15rem; font-weight: 700; color: var(--text-main);">{dims.revision_behavior.revision_rate_pct}%</div>
                </div>
                <div>
                  <div style="font-size: 0.72rem; color: var(--text-subtle); text-transform: uppercase;">Schema Stability</div>
                  <div style="font-size: 1.15rem; font-weight: 700; color: var(--text-main);">{dims.schema_stability.stable_snapshots_pct}%</div>
                </div>
              </div>
            </div>

            {s.accuracy ? (
              <div style="border: 1px solid rgba(56, 189, 248, 0.3); background-color: var(--primary-glow); padding: 0.75rem; border-radius: 6px; margin-bottom: 1.25rem;">
                <div style="font-size: 0.72rem; font-weight: 700; color: var(--primary); text-transform: uppercase;">Anchored Accuracy (Rule H1)</div>
                <div style="font-size: 1.05rem; font-weight: 800; color: var(--text-main); margin-top: 0.15rem;">
                  {s.accuracy.score} {s.accuracy.unit} <span style="font-size: 0.8rem; font-weight: normal; color: var(--text-muted);">({s.accuracy.metric})</span>
                </div>
                <div style="font-size: 0.72rem; color: var(--text-muted); margin-top: 0.25rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                  Anchor: {s.accuracy.anchor}
                </div>
              </div>
            ) : (
              <div style="border: 1px dashed var(--border); background-color: var(--bg-surface); padding: 0.65rem 0.75rem; border-radius: 6px; margin-bottom: 1.25rem; font-size: 0.78rem; color: var(--text-subtle);">
                Rule H1: Accuracy omitted (no independent settlement anchor designated).
              </div>
            )}
          </div>

          <a href={`/scorecards/${s.source_id}`} class="btn btn-secondary" style="width: 100%; justify-content: center; font-size: 0.88rem;">
            View Detailed Scorecard &rarr;
          </a>
        </div>
      );
    })}
  </div>

  <section style="background-color: var(--bg-surface); border: 1px solid var(--border); border-radius: 10px; padding: 2rem;">
    <h2 style="font-size: 1.35rem; font-weight: 700; margin-bottom: 0.5rem;">How to consume scorecards programmatically</h2>
    <p style="color: var(--text-muted); font-size: 0.95rem; margin-bottom: 1.25rem;">
      Scorecard metrics are updated by the batch pipeline and served as public JSON assets conforming to <code>schema/scorecard/v0.1.json</code>:
    </p>
    <pre><code># Fetch JSON scorecard for any source
curl -s https://trooth.io/scorecards/nws.json | jq .dimensions

# Get list of all active scorecards
curl -s https://trooth.io/scorecards/manifest.json | jq .sources</code></pre>
  </section>
</Layout>
