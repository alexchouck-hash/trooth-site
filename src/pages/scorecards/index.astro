---
import Layout from '../../layouts/Layout.astro';
import { p } from '../../utils/paths';
import { MODAFIED_ORIGIN, MODAFIED_EMBED_SRC, MODAFIED_METHOD_URL, modafiedCardUrl } from '../../utils/modafied';
import registry from '../../data/registry.json';

/**
 * Trooth publishes no scorecards (ADR-0014).
 *
 * This route used to render numbers Trooth computed itself. It no longer exists in that form,
 * and the route is kept rather than deleted so that every link and bookmark to it lands
 * somewhere that explains where the grades went instead of a 404.
 *
 * The emblems below are fetched from Modafied at view time by its own embed script. Nothing on
 * this page is a copy of a grade, because a funder caching a funder-flattering grade is
 * indistinguishable from a funder editing it.
 */

const sources = (registry.groups as any[])
  .flatMap((g) => g.entries)
  .filter((e: any) => e.status === 'promoted')
  .sort((a: any, b: any) => a.name.localeCompare(b.name));
---

<Layout
  title="Source Scorecards"
  description="Independent grades for every source Trooth routes to, published by Modafied."
  activeNav="scorecards"
>
  <div style="margin-bottom: 2.5rem;">
    <div style="display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 1rem; margin-bottom: 0.75rem;">
      <h1 style="font-size: 2.25rem; font-weight: 800; letter-spacing: -0.02em;">Source Scorecards</h1>
      <span class="badge-tag">Graded by Modafied</span>
    </div>
    <p style="color: var(--text-muted); font-size: 1.1rem; max-width: 820px;">
      Every source Trooth routes to is graded across six mechanical dimensions. We do not do that
      grading, and we do not keep a copy of the result. The emblems below are fetched from
      <a href={MODAFIED_ORIGIN} target="_blank" rel="noopener">Modafied</a> as you load this page,
      so what you see is whatever the benchmark currently publishes.
    </p>
  </div>

  <section style="border: 1px solid var(--border); border-radius: 12px; padding: 1.5rem; margin-bottom: 2.5rem; background: var(--bg-card);">
    <h2 style="font-size: 1.15rem; font-weight: 700; margin-bottom: 0.6rem;">Why we do not grade our own sources</h2>
    <p style="color: var(--text-muted); margin-bottom: 0.75rem;">
      Trooth sells the pipe these feeds travel through. A score published by the company selling
      you the pipe is discounted by every serious reader, usually to zero, so publishing one was
      worth less than not publishing one.
    </p>
    <p style="color: var(--text-muted); margin-bottom: 0.75rem;">
      Modafied collects its own snapshots, on its own schedule, with its own clock. That last part
      is not a detail: freshness lag is the grader's clock minus the source's own event timestamp,
      so a grader working from somebody else's archive is measuring that supplier's scheduler
      rather than the source. Handing Modafied our snapshots would have made the independence
      claim false in the first respect anyone would check.
    </p>
      <p style="color: var(--text-subtle); font-size: 0.9rem;">
      Trooth funds Modafied, and every Modafied page says so. Trooth's own MCP server will be
      graded there by the same code once it exists.
    </p>
  </section>

  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.25rem; margin-bottom: 3rem;">
    {sources.map((source: any) => (
      <div style="border: 1px solid var(--border); border-radius: 12px; padding: 1.5rem; background: var(--bg-card);">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; margin-bottom: 0.75rem;">
          <div>
            <h3 style="font-size: 1.1rem; font-weight: 700; margin-bottom: 0.2rem;">{source.name}</h3>
            <div style="font-family: var(--font-mono); font-size: 0.8rem; color: var(--text-subtle);">{source.id}</div>
          </div>
        </div>

        <div style="margin-bottom: 0.9rem;"><span data-modafied={source.id}></span></div>

        <p style="font-size: 0.9rem; color: var(--text-muted); margin-bottom: 1rem;">{source.why}</p>

        <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
          <a href={p(`/scorecards/${source.id}`)} style="font-size: 0.88rem; font-weight: 600;">Details</a>
          <a href={modafiedCardUrl(source.id)} target="_blank" rel="noopener" style="font-size: 0.88rem; font-weight: 600;">Modafied card &rarr;</a>
        </div>
      </div>
    ))}
  </div>

  <section>
    <p style="color: var(--text-subtle); font-size: 0.88rem; line-height: 1.7;">
      A feed reading <em>insufficient data</em> has not been withheld or hidden. It means the
      benchmark does not yet have the samples to grade it, and saying so rather than showing a
      confident number is the entire point.
      Read <a href={MODAFIED_METHOD_URL} target="_blank" rel="noopener">the published method</a>,
      or see <a href={p('/connect')}>every connector we intend to support</a>.
    </p>
  </section>

  <script is:inline defer src={MODAFIED_EMBED_SRC}></script>
</Layout>
