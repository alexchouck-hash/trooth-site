---
import { p } from '../utils/paths';

interface Props {
  title: string;
  description?: string;
  activeNav?: string;
}

const {
  title,
  description = "Trooth: The Single Data Connector and Provenance Pipe for Apps and Agents. Signed envelopes, six tools, public scorecards.",
  activeNav = ""
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Trooth</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0f172a" />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>⚡</text></svg>" />
    <style is:global>
      :root {
        --font-sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        --font-mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
        --bg-page: #0b0f19;
        --bg-surface: #111827;
        --bg-surface-subtle: #1f2937;
        --bg-card: #131d31;
        --border: #2d3748;
        --border-subtle: #1e293b;
        --text-main: #f8fafc;
        --text-muted: #94a3b8;
        --text-subtle: #64748b;
        --primary: #38bdf8;
        --primary-glow: rgba(56, 189, 248, 0.15);
        --primary-hover: #0284c7;
        --accent-green: #34d399;
        --accent-amber: #fbbf24;
        --accent-rose: #f43f5e;
        --code-bg: #030712;
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        font-family: var(--font-sans);
        color: var(--text-main);
        background-color: var(--bg-page);
        line-height: 1.6;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        -webkit-font-smoothing: antialiased;
      }

      header {
        border-bottom: 1px solid var(--border);
        background-color: rgba(11, 15, 25, 0.88);
        backdrop-filter: blur(12px);
        position: sticky;
        top: 0;
        z-index: 100;
      }

      .nav-container {
        max-width: 1160px;
        margin: 0 auto;
        padding: 0.85rem 1.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .brand {
        font-weight: 800;
        font-size: 1.35rem;
        text-decoration: none;
        color: var(--text-main);
        display: flex;
        align-items: center;
        gap: 0.6rem;
        letter-spacing: -0.03em;
      }

      .brand-icon {
        width: 28px;
        height: 28px;
        background: linear-gradient(135deg, #38bdf8, #2563eb);
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 900;
        font-size: 0.85rem;
        color: white;
      }

      .badge-tag {
        font-size: 0.72rem;
        background-color: var(--primary-glow);
        color: var(--primary);
        border: 1px solid rgba(56, 189, 248, 0.3);
        padding: 0.15rem 0.5rem;
        border-radius: 9999px;
        font-weight: 600;
        letter-spacing: 0.02em;
      }

      nav {
        display: flex;
        align-items: center;
        gap: 1.25rem;
      }

      nav a {
        text-decoration: none;
        color: var(--text-muted);
        font-size: 0.92rem;
        font-weight: 500;
        transition: color 0.15s ease;
      }

      nav a:hover, nav a.active {
        color: var(--primary);
      }

      .nav-cta {
        background-color: var(--primary);
        color: #0b0f19 !important;
        padding: 0.45rem 0.9rem;
        border-radius: 6px;
        font-weight: 600;
        transition: background-color 0.15s ease;
      }

      .nav-cta:hover {
        background-color: #7dd3fc;
      }

      main {
        max-width: 1160px;
        width: 100%;
        margin: 0 auto;
        padding: 3rem 1.5rem;
        flex: 1;
      }

      footer {
        border-top: 1px solid var(--border);
        background-color: var(--bg-surface);
        padding: 3.5rem 1.5rem 2.5rem;
        margin-top: 5rem;
        font-size: 0.9rem;
        color: var(--text-muted);
      }

      .footer-container {
        max-width: 1160px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: 2fr 1fr 1fr 1fr;
        gap: 2.5rem;
        margin-bottom: 2.5rem;
      }

      .footer-bottom {
        max-width: 1160px;
        margin: 0 auto;
        padding-top: 1.5rem;
        border-top: 1px solid var(--border);
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.82rem;
        color: var(--text-subtle);
        flex-wrap: wrap;
        gap: 1rem;
      }

      .footer-column h4 {
        color: var(--text-main);
        font-size: 0.9rem;
        font-weight: 700;
        margin-bottom: 0.85rem;
        letter-spacing: 0.02em;
        text-transform: uppercase;
      }

      .footer-column ul {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 0.55rem;
      }

      .footer-column a {
        color: var(--text-muted);
        text-decoration: none;
        transition: color 0.15s;
      }

      .footer-column a:hover {
        color: var(--primary);
      }

      pre, code {
        font-family: var(--font-mono);
      }

      code {
        background-color: var(--bg-surface-subtle);
        padding: 0.15rem 0.4rem;
        border-radius: 4px;
        font-size: 0.88em;
        color: #e2e8f0;
      }

      pre {
        background-color: var(--code-bg);
        border: 1px solid var(--border);
        padding: 1.25rem;
        border-radius: 8px;
        overflow-x: auto;
        font-size: 0.88rem;
        line-height: 1.55;
        margin: 1.25rem 0;
      }

      pre code {
        background: transparent;
        padding: 0;
        color: #e2e8f0;
      }

      table {
        width: 100%;
        border-collapse: collapse;
        margin: 1.5rem 0;
        font-size: 0.92rem;
      }

      th, td {
        border: 1px solid var(--border);
        padding: 0.85rem 1.1rem;
        text-align: left;
      }

      th {
        background-color: var(--bg-surface-subtle);
        color: var(--text-main);
        font-weight: 600;
      }

      tr:nth-child(even) td {
        background-color: rgba(31, 41, 55, 0.35);
      }

      .card {
        background-color: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 1.5rem;
        transition: border-color 0.2s ease, transform 0.2s ease;
      }

      .card:hover {
        border-color: rgba(56, 189, 248, 0.4);
      }

      .btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.7rem 1.35rem;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
        font-size: 0.95rem;
        transition: all 0.15s ease;
        border: 1px solid transparent;
      }

      .btn-primary {
        background-color: var(--primary);
        color: #0b0f19;
      }

      .btn-primary:hover {
        background-color: #7dd3fc;
        transform: translateY(-1px);
      }

      .btn-secondary {
        background-color: var(--bg-surface-subtle);
        border-color: var(--border);
        color: var(--text-main);
      }

      .btn-secondary:hover {
        border-color: var(--primary);
        color: var(--primary);
        transform: translateY(-1px);
      }

      .badge {
        display: inline-block;
        padding: 0.2rem 0.6rem;
        font-size: 0.75rem;
        font-weight: 600;
        border-radius: 4px;
        background-color: var(--bg-surface-subtle);
        border: 1px solid var(--border);
      }

      .badge-green {
        background-color: rgba(52, 211, 153, 0.12);
        color: var(--accent-green);
        border-color: rgba(52, 211, 153, 0.3);
      }

      .badge-amber {
        background-color: rgba(251, 191, 36, 0.12);
        color: var(--accent-amber);
        border-color: rgba(251, 191, 36, 0.3);
      }

      .badge-blue {
        background-color: var(--primary-glow);
        color: var(--primary);
        border-color: rgba(56, 189, 248, 0.3);
      }

      @media (max-width: 900px) {
        .footer-container {
          grid-template-columns: 1fr 1fr;
        }
      }

      @media (max-width: 680px) {
        .nav-container {
          flex-direction: column;
          align-items: flex-start;
          gap: 1rem;
        }
        nav {
          flex-wrap: wrap;
          gap: 0.85rem;
        }
        .footer-container {
          grid-template-columns: 1fr;
        }
        main {
          padding: 2rem 1rem;
        }
      }
    </style>
  </head>
  <body>
    <header>
      <div class="nav-container">
        <a href={p('/')} class="brand">
          <div class="brand-icon">T</div>
          Trooth
          <span class="badge-tag">Benchmark v0</span>
        </a>
        <nav>
          <a href={p('/')} class={activeNav === "home" ? "active" : ""}>Overview</a>
          <a href={p('/scorecards')} class={activeNav === "scorecards" ? "active" : ""}>Scorecards</a>
          <a href={p('/console')} class={activeNav === "console" ? "active" : ""}>Console</a>
          <a href={p('/connect')} class={activeNav === "connect" ? "active" : ""}>Connect</a>
          <a href={p('/method')} class={activeNav === "method" ? "active" : ""}>Methodology</a>
          <a href={p('/docs')} class={activeNav === "docs" ? "active" : ""}>Docs</a>
          <a href={p('/providers')} class={activeNav === "providers" ? "active" : ""}>Providers</a>
          <a href={p('/pricing')} class={activeNav === "pricing" ? "active" : ""}>Pricing</a>
          <a href={p('/status')} class={activeNav === "status" ? "active" : ""}>Status</a>
          <a href={p('/docs')} class="nav-cta">Quickstart</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <div class="footer-container">
        <div>
          <div class="brand" style="margin-bottom: 0.8rem;">
            <div class="brand-icon">T</div>
            Trooth
          </div>
          <p style="margin-bottom: 1rem; max-width: 380px; color: var(--text-muted); font-size: 0.88rem;">
            The single data connector for apps and autonomous agents. Every fetch returns a cryptographically signed envelope with verifiable freshness, lineage, and audit records.
          </p>
          <p style="font-size: 0.8rem; color: var(--text-subtle);">
            Mechanically computed scorecards. No manual overrides. No sponsored placement. Ever.
          </p>
        </div>

        <div class="footer-column">
          <h4>Benchmark</h4>
          <ul>
            <li><a href={p('/scorecards')}>Public Scorecards</a></li>
            <li><a href={p('/method')}>Scoring Methodology</a></li>
            <li><a href={p('/status')}>System Status</a></li>
            <li><a href={p('/console')}>Trooth Console (free)</a></li>
            <li><a href={p('/connect')}>Connect &amp; Integrations</a></li>
            <li><a href="https://alexchouck-hash.github.io/kourob/">KouroB Nodes</a></li>
            <li><a href="https://alexchouck-hash.github.io/modafied-site/">Modafied (MCP benchmarks)</a></li>
            <li><a href={p('/scorecards/nws')}>NWS Weather Card</a></li>
            <li><a href={p('/scorecards/usgs-earthquake')}>USGS Seismic Card</a></li>
          </ul>
        </div>

        <div class="footer-column">
          <h4>Developers</h4>
          <ul>
            <li><a href={p('/docs')}>Quickstart (5 Min)</a></li>
            <li><a href={p('/docs#mcp')}>MCP Installation</a></li>
            <li><a href={p('/docs#rest')}>REST Endpoints</a></li>
            <li><a href={p('/pricing')}>Pricing & Quotas</a></li>
            <li><a href={p('/roadmap')}>Project Roadmap</a></li>
          </ul>
        </div>

        <div class="footer-column">
          <h4>Ecosystem</h4>
          <ul>
            <li><a href={p('/providers')}>List Your Feed</a></li>
            <li><a href="https://github.com/alexchouck-hash/trooth-site" target="_blank" rel="noopener">GitHub Repository</a></li>
            <li><a href={p('/method#anchor')}>The Anchor Rule</a></li>
            <li><a href={p('/docs#envelope')}>Envelope Schema</a></li>
          </ul>
        </div>
      </div>

      <div class="footer-bottom">
        <div>&copy; 2026 Alex Houck / Trooth Contributors. Open source under Apache-2.0.</div>
        <div style="display: flex; gap: 1.5rem;">
          <a href={p('/method')} style="color: var(--text-subtle); text-decoration: none;">Methodology v0.1</a>
          <a href={p('/pricing')} style="color: var(--text-subtle); text-decoration: none;">$50/mo Cap Rule</a>
          <a href="https://github.com/alexchouck-hash/trooth-site" style="color: var(--text-subtle); text-decoration: none;">Source Code</a>
        </div>
      </div>
    </footer>
  </body>
</html>
