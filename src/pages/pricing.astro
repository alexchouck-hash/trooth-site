---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Pricing & Quotas" activeNav="pricing">
  <div style="max-width: 900px; margin: 0 auto;">
    <!-- Hero -->
    <div style="text-align: center; margin-bottom: 3.5rem;">
      <h1 style="font-size: clamp(2rem, 4vw, 2.75rem); font-weight: 900; letter-spacing: -0.025em; margin-bottom: 0.75rem;">
        Transparent, Metered Pricing
      </h1>
      <p style="color: var(--text-muted); font-size: 1.15rem; max-width: 650px; margin: 0 auto;">
        No hidden fees. The free tier requires no account. Paid tiers unlock historical replay depth, revision webhooks, and pass-through credentials.
      </p>
    </div>

    <!-- Pricing Tiers Grid -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(270px, 1fr)); gap: 1.5rem; margin-bottom: 4.5rem;">
      <!-- Free Tier -->
      <div class="card" style="display: flex; flex-direction: column; justify-content: space-between;">
        <div>
          <span class="badge badge-green" style="margin-bottom: 0.75rem;">Free Forever</span>
          <h3 style="font-size: 1.35rem; font-weight: 800; margin-bottom: 0.5rem;">Community</h3>
          <div style="font-size: 2.2rem; font-weight: 900; color: var(--text-main); margin-bottom: 1rem;">
            $0 <span style="font-size: 0.95rem; font-weight: normal; color: var(--text-muted);">/ month</span>
          </div>
          <p style="font-size: 0.88rem; color: var(--text-muted); margin-bottom: 1.5rem;">
            For individuals, open-source projects, and autonomous agents testing tools.
          </p>

          <ul style="list-style: none; display: flex; flex-direction: column; gap: 0.65rem; font-size: 0.9rem; margin-bottom: 2rem;">
            <li style="display: flex; gap: 0.5rem;">
              <span style="color: var(--accent-green);">✓</span> 1,000 requests per day (by IP)
            </li>
            <li style="display: flex; gap: 0.5rem;">
              <span style="color: var(--accent-green);">✓</span> No account or credit card needed
            </li>
            <li style="display: flex; gap: 0.5rem;">
              <span style="color: var(--accent-green);">✓</span> Access to all 5 public sources
            </li>
            <li style="display: flex; gap: 0.5rem;">
              <span style="color: var(--accent-green);">✓</span> Ed25519 signed envelopes
            </li>
            <li style="display: flex; gap: 0.5rem;">
              <span style="color: var(--accent-green);">✓</span> 7-day snapshot cache
            </li>
          </ul>
        </div>

        <a href="/docs" class="btn btn-secondary" style="width: 100%; justify-content: center;">
          Start with Free Tier
        </a>
      </div>

      <!-- Pro Tier -->
      <div class="card" style="display: flex; flex-direction: column; justify-content: space-between; border-color: #38bdf8; background-color: #12213d; position: relative;">
        <div style="position: absolute; top: -11px; right: 20px;">
          <span class="badge badge-blue">Most Popular</span>
        </div>

        <div>
          <span class="badge badge-blue" style="margin-bottom: 0.75rem;">Production</span>
          <h3 style="font-size: 1.35rem; font-weight: 800; margin-bottom: 0.5rem;">Pro Agent</h3>
          <div style="font-size: 2.2rem; font-weight: 900; color: var(--primary); margin-bottom: 1rem;">
            $39 <span style="font-size: 0.95rem; font-weight: normal; color: var(--text-muted);">/ month</span>
          </div>
          <p style="font-size: 0.88rem; color: var(--text-muted); margin-bottom: 1.5rem;">
            For autonomous agent teams and production backends needing replay depth.
          </p>

          <ul style="list-style: none; display: flex; flex-direction: column; gap: 0.65rem; font-size: 0.9rem; margin-bottom: 2rem;">
            <li style="display: flex; gap: 0.5rem;">
              <span style="color: var(--primary);">✓</span> 100,000 requests per month
            </li>
            <li style="display: flex; gap: 0.5rem;">
              <span style="color: var(--primary);">✓</span> API key with quota controls
            </li>
            <li style="display: flex; gap: 0.5rem;">
              <span style="color: var(--primary);">✓</span> 1-year historical snapshot replay
            </li>
            <li style="display: flex; gap: 0.5rem;">
              <span style="color: var(--primary);">✓</span> Revision and schema change webhooks
            </li>
            <li style="display: flex; gap: 0.5rem;">
              <span style="color: var(--primary);">✓</span> OpenTimestamps Bitcoin anchoring
            </li>
          </ul>
        </div>

        <a href="#pro-waitlist" class="btn btn-primary" style="width: 100%; justify-content: center;">
          Join Phase 2 Waitlist
        </a>
      </div>

      <!-- Enterprise Tier -->
      <div class="card" style="display: flex; flex-direction: column; justify-content: space-between;">
        <div>
          <span class="badge" style="margin-bottom: 0.75rem;">Bespoke</span>
          <h3 style="font-size: 1.35rem; font-weight: 800; margin-bottom: 0.5rem;">Enterprise</h3>
          <div style="font-size: 2.2rem; font-weight: 900; color: var(--text-main); margin-bottom: 1rem;">
            Custom
          </div>
          <p style="font-size: 0.88rem; color: var(--text-muted); margin-bottom: 1.5rem;">
            For organizations with proprietary data sources and SLA guarantees.
          </p>

          <ul style="list-style: none; display: flex; flex-direction: column; gap: 0.65rem; font-size: 0.9rem; margin-bottom: 2rem;">
            <li style="display: flex; gap: 0.5rem;">
              <span style="color: var(--accent-green);">✓</span> Encrypted pass-through credentials
            </li>
            <li style="display: flex; gap: 0.5rem;">
              <span style="color: var(--accent-green);">✓</span> Private custom source scorecards
            </li>
            <li style="display: flex; gap: 0.5rem;">
              <span style="color: var(--accent-green);">✓</span> RFC 3161 TSA enterprise timestamps
            </li>
            <li style="display: flex; gap: 0.5rem;">
              <span style="color: var(--accent-green);">✓</span> Custom SLA and dedicated egress
            </li>
          </ul>
        </div>

        <a href="mailto:contact@trooth.io" class="btn btn-secondary" style="width: 100%; justify-content: center;">
          Contact Enterprise Team
        </a>
      </div>
    </div>

    <!-- Ethical Commitments -->
    <section class="card" style="margin-bottom: 4rem;">
      <h2 style="font-size: 1.4rem; font-weight: 800; margin-bottom: 1rem; color: var(--text-main);">
        Our Economic & Architectural Commitments
      </h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.5rem;">
        <div>
          <h4 style="color: var(--primary); font-size: 1rem; margin-bottom: 0.35rem;">No GPU / LLM in Hot Path</h4>
          <p style="font-size: 0.88rem; color: var(--text-muted);">
            Routing is an ultra-fast, deterministic catalog lookup. We do not burn expensive tokens or introduce latency in the routing loop.
          </p>
        </div>

        <div>
          <h4 style="color: var(--primary); font-size: 1rem; margin-bottom: 0.35rem;">Hard $50/mo Cap (Rule H6)</h4>
          <p style="font-size: 0.88rem; color: var(--text-muted);">
            We maintain a strict $50/month infrastructure cost ceiling during initial phases. Trooth operates on free edge tiers to ensure longevity.
          </p>
        </div>

        <div>
          <h4 style="color: var(--primary); font-size: 1rem; margin-bottom: 0.35rem;">No Sponsored Scores</h4>
          <p style="font-size: 0.88rem; color: var(--text-muted);">
            Every score is mechanical. We never take money from providers to inflate scores or suppress lag metrics. Integrity is our entire brand.
          </p>
        </div>
      </div>
    </section>
  </div>
</Layout>
