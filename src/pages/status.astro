---
import Layout from '../layouts/Layout.astro';
import { p } from '../utils/paths';
import { MODAFIED_ORIGIN, MODAFIED_EMBED_SRC, modafiedCardUrl } from '../utils/modafied';
import registry from '../data/registry.json';
import fs from 'node:fs';
import path from 'node:path';

/**
 * Status.
 *
 * This page used to read Trooth's own scorecards for freshness and print a hardcoded
 * "All Upstream Feeds Operational" badge regardless of what was underneath it. Both are gone:
 * the scorecards because Trooth no longer computes any (ADR-0014), and the badge because a
 * status page that cannot say "degraded" is decoration.
 *
 * What is honest to show today is narrow, so that is what is shown. Freshness signal comes from
 * Modafied's live emblems. The snapshot archive is not yet persisting, and this page says so
 * rather than implying a history that does not exist.
 */

function readJson(file: string) {
  try { return fs.existsSync(file) ? JSON.parse(fs.readFileSync(file, 'utf-8')) : null; }
  catch { return null; }
}

const emblemIndex = readJson(path.resolve('./public/emblems/index.json'));
const modafied = emblemIndex?.modafied ?? null;

const sources = (registry.groups as any[])
  .flatMap((g) => g.entries ?? [])
  .filter((e: any) => e.status === 'promoted')
  .sort((a: any, b: any) => a.name.localeCompare(b.name));

const graded = modafied?.ratings?.filter((r: any) => r.grade) ?? [];
const mismatched = modafied?.integrity?.mismatch ?? 0;

const facts: [string, string, string][] = [
  ['Sources in the routing catalog', String(sources.length), 'ok'],
  ['Connectors in the registry', String(registry.total), 'ok'],
  ['Graded by Modafied', `${graded.length} of ${modafied?.count ?? 0}`, graded.length ? 'ok' : 'warn'],
  ['Snapshot archive', 'not persisting', 'warn'],
];

const COLOR: Record<string, string> = { ok: 'var(--accent-green)', warn: 'var(--accent-amber)' };
---

<Layout
  title="Status"
  description="What Trooth is collecting, what Modafied is grading, and what is not working yet."
  activeNav="status"
>
  <div style="max-width: 960px; margin: 0 auto;">
    <div style="margin-bottom: 2rem;">
      <h1 style="font-size: clamp(2rem, 4vw, 2.6rem); font-weight: 900; letter-spacing: -0.025em; margin-bottom: 0.6rem;">
        Status
      </h1>
      <p style="color: var(--text-muted); font-size: 1.05rem; max-width: 820px;">
        Freshness comes from <a href={MODAFIED_ORIGIN} target="_blank" rel="noopener">Modafied</a>,
        which measures it with its own clock. Trooth reports only what it can currently stand
        behind, which is less than this page used to claim.
      </p>
    </div>

    <section style="margin-bottom: 2.5rem;">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 1rem;">
        {facts.map(([label, value, state]) => (
          <div style={`border: 1px solid var(--border); border-left: 3px solid ${COLOR[state]}; border-radius: 10px; padding: 0.95rem 1.1rem; background: var(--bg-card);`}>
            <div style="font-size: 0.75rem; color: var(--text-subtle); text-transform: uppercase; letter-spacing: 0.06em;">{label}</div>
            <div style="font-size: 1.25rem; font-weight: 800; margin-top: 0.25rem;">{value}</div>
          </div>
        ))}
      </div>
    </section>

    <section style="border: 1px solid var(--accent-amber); background: rgba(251, 191, 36, 0.08); border-radius: 10px; padding: 1.25rem 1.5rem; margin-bottom: 2.5rem;">
      <h2 style="font-size: 1.1rem; font-weight: 700; margin-bottom: 0.5rem;">Known, and not fixed yet</h2>
      <ul style="margin-left: 1.2rem; color: var(--text-muted); display: flex; flex-direction: column; gap: 0.4rem;">
        <li>
          <strong>The snapshot archive is not persisting.</strong> The scheduled job writes to the
          runner's disk and the runner is then destroyed, so no history accumulates. Until that is
          fixed, replay and the derived feeds it would support do not exist.
        </li>
        {mismatched > 0 && (
          <li>
            <strong>Modafied's manifest does not match the files it lists.</strong> {mismatched} of
            its published ratings fail our integrity check, because the manifest describes an
            earlier generation of its own artifacts. That is a publisher bug rather than an attack.
            The grades below are shown with that caveat and are not used for routing.
          </li>
        )}
      </ul>
    </section>

    <section style="margin-bottom: 2.5rem;">
      <h2 style="font-size: 1.35rem; font-weight: 700; margin-bottom: 1rem;">Sources we route to</h2>
      <div style="display: flex; flex-direction: column; gap: 0.9rem;">
        {sources.map((source: any) => (
          <div style="border: 1px solid var(--border); border-radius: 10px; padding: 1.1rem 1.25rem; background: var(--bg-card); display: flex; justify-content: space-between; align-items: center; gap: 1.25rem; flex-wrap: wrap;">
            <div style="min-width: 220px;">
              <a href={p(`/scorecards/${source.id}`)} style="font-weight: 700;">{source.name}</a>
              <div style="font-family: var(--font-mono); font-size: 0.78rem; color: var(--text-subtle); margin-top: 0.15rem;">
                {source.id} &middot; {source.refresh_cadence ?? source.domain ?? source.kind}
              </div>
            </div>
            <span data-modafied={source.id}></span>
            <a href={modafiedCardUrl(source.id)} target="_blank" rel="noopener" style="font-size: 0.85rem;">Modafied card &rarr;</a>
          </div>
        ))}
      </div>
    </section>

    <section>
      <p style="color: var(--text-subtle); font-size: 0.87rem; line-height: 1.7;">
        A feed reading <em>insufficient data</em> has not been withheld. It means the benchmark
        does not yet have the samples to grade it. Trooth publishes no grades of its own
        (ADR-0014), so there is nothing here we could have quietly rounded up.
      </p>
    </section>
  </div>

  <script is:inline defer src={MODAFIED_EMBED_SRC}></script>
</Layout>
