---
import Layout from '../layouts/Layout.astro';
import Emblem from '../components/Emblem.astro';
import { MODAFIED_EMBED_SRC } from '../utils/modafied';
import { p } from '../utils/paths';
import registry from '../data/registry.json';
import demand from '../data/demand.json';
import ui from '../data/ui-outputs.json';
import connect from '../data/connect.json';
import fs from 'node:fs';
import path from 'node:path';

const allEntries = (registry.groups as any[]).flatMap((g) => g.entries ?? []);
const promoted = allEntries.filter((e: any) => e.status === 'promoted');
const priorityOne = allEntries.filter((e: any) => e.status === 'candidate' && e.priority === 1);

const clients: [string, string][] = [
  ['Claude Code and Claude Desktop', 'stdio, streamable HTTP'],
  ['Cursor', 'stdio, streamable HTTP'],
  ['VS Code with GitHub Copilot', 'stdio, streamable HTTP'],
  ['Windsurf', 'stdio'],
  ['Zed', 'stdio'],
  ['Cline', 'stdio'],
  ['Continue', 'stdio'],
  ['Goose', 'stdio, streamable HTTP'],
  ['Raycast', 'stdio'],
  ['JetBrains IDEs', 'stdio'],
];

const frameworks = 'Anthropic Agent SDK, OpenAI Agents SDK, LangChain and LangGraph, LlamaIndex, CrewAI, AutoGen, Pydantic AI, Mastra, Vercel AI SDK, Semantic Kernel, Haystack, DSPy';
const automation = 'n8n, Node-RED, Windmill, Temporal, Apache Airflow, Dagster, Prefect, Huginn, Zapier, Make, Pipedream, Activepieces';

// The seam between Trooth and KouroB, taken from KouroB's own KNP specifications rather than
// paraphrased. Both make something verifiable: Trooth the outside world, KouroB a node's own
// answers. Neither is the other's interface.
const seam: [string, string, string][] = [
  ['Response shape', 'Envelope: data, provenance, signature', 'data, rendered, citations, receipt_id (KNP-0)'],
  ['Signing', 'Ed25519 envelopes, SHA-256 content hashes', 'Ed25519 hash-chained receipt ledger (KNP-2)'],
  ['Corrections', 'Snapshots append-only; corrections supersede', 'Outcomes judge past receipts without editing them (KNP-2)'],
  ['Saying no', 'considered_and_rejected, with reasons', 'Refusal, referral and bridging out of scope (KNP-1)'],
  ['Cost', 'quota and cost_units inside every envelope', 'Quoted ceiling the final receipt never exceeds (KNP-3)'],
  ['Untrusted text', 'Quarantined in untrusted_text, never obeyed', 'Ingest gate validates and quarantines invalid rows'],
  ['Models', 'No model on the hot path, ever', 'T0 rules and SQL answer first; frontier LLM is last resort'],
];

const kourobCli = [
  'pipx install kourob',
  'kourob init my-cell && cd my-cell',
  'kourob ingest fixtures/events.jsonl',
  'kourob serve --mcp        # query, ingest, get_page, list_schemas, submit_outcome',
  'kourob attach claude-code # also: cursor, windsurf',
].join('\n');

const cascade: [string, string][] = [
  ['T0', 'compiled rules and cached SQL'],
  ['T1', 'distilled model'],
  ['T2', 'specialized model'],
  ['T3', 'frontier LLM'],
  ['T4', 'human review'],
];
---

<Layout
  title="Connect"
  description="What Trooth feeds connect to: KouroB nodes, agent clients, automation, and 108 open source UI tools."
  activeNav="connect"
>
  <section style="margin-bottom:2.5rem;">
    <h1 style="font-size:2.25rem; font-weight:800; margin-bottom:0.75rem;">Connect</h1>
    <p style="font-size:1.1rem; color:var(--text-muted); max-width:760px;">
      Trooth is a pipe, and a pipe is only worth having if something is on the other end of it.
      This is what the feeds connect to: the analysis layer, the agent clients, the automation
      tools, and the open source dashboards that can render a feed without anyone building a UI.
    </p>
  </section>

  <section style="margin-bottom:3.5rem;">
    <div style="display:flex; align-items:baseline; gap:0.75rem; flex-wrap:wrap; margin-bottom:0.35rem;">
      <h2 style="font-size:1.5rem; font-weight:700;">1. KouroB</h2>
      <span class="badge-tag">v0.1</span>
      <span class="badge-tag">Open protocol</span>
      <span class="badge-tag">Apache-2.0</span>
    </div>
    <p style="font-size:1.15rem; color:var(--text-main); margin-bottom:0.75rem;">
      Self-specializing nodes that agents attach to.
    </p>
    <p style="color:var(--text-muted); max-width:820px; margin-bottom:1rem;">
      A KouroB node is not an agent, a chat memory, or an LLM wrapper. It is an independent,
      metered unit of knowledge that gets cheaper the more it is used. A query runs down a
      five-tier cascade and stops at the first tier that can answer it. Frontier models train
      the node; they do not serve it.
    </p>

    <div style="display:flex; flex-wrap:wrap; gap:0.5rem; margin-bottom:1.25rem;">
      {cascade.map(([tier, what]) => (
        <span style="border:1px solid var(--border); background:var(--bg-card); padding:0.3rem 0.7rem; border-radius:8px; font-size:0.85rem;">
          <strong style="color:var(--primary); font-family:var(--font-mono);">{tier}</strong>
          <span style="color:var(--text-muted); margin-left:0.4rem;">{what}</span>
        </span>
      ))}
    </div>

    <p style="color:var(--text-muted); max-width:820px; margin-bottom:1.25rem;">
      Every answer leaves an ed25519-signed receipt carrying the request hash, the response
      hash, the tier that served it, the citations, the cost in credits, and a cryptographic
      pointer to the previous receipt. The ledger is append-only and hash-chained, so history
      cannot be quietly rewritten.
    </p>

    <pre style="margin-bottom:1.5rem;"><code>{kourobCli}</code></pre>

    <h3 style="font-size:1.1rem; font-weight:700; margin-bottom:0.5rem;">Why this pairs with Trooth</h3>
    <p style="color:var(--text-muted); max-width:820px; margin-bottom:1rem;">
      Trooth and KouroB were built from the same conviction, at opposite ends. Trooth makes the
      outside world verifiable: which upstream published a value, when, under what licence, and
      what it disagreed with. KouroB makes a node's own answers verifiable: which tier served
      them, from which events, at what cost. Neither is the other's interface. They meet in the
      middle, and the seams line up unusually well.
    </p>

    <div style="overflow-x:auto; margin-bottom:1.5rem;">
      <table>
        <thead><tr><th></th><th>Trooth</th><th>KouroB</th></tr></thead>
        <tbody>
          {seam.map(([label, a, b]) => (
            <tr><td style="white-space:nowrap;"><strong>{label}</strong></td><td>{a}</td><td>{b}</td></tr>
          ))}
        </tbody>
      </table>
    </div>

    <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(300px, 1fr)); gap:1rem; margin-bottom:1.25rem;">
      <div style="border:1px solid var(--border); border-radius:10px; padding:1.1rem 1.25rem; background:var(--bg-card);">
        <h4 style="font-weight:700; margin-bottom:0.4rem;">Trooth into a node</h4>
        <p style="font-size:0.92rem; color:var(--text-muted); margin:0;">
          An envelope is close to an ideal ingest payload: already schema-valid, content-hashed,
          stamped with both the source's event time and our capture time, and carrying the
          licence chain. A node grounded in envelopes can cite provenance past its own boundary,
          all the way to the upstream publisher, instead of stopping at the node itself.
        </p>
      </div>
      <div style="border:1px solid var(--border); border-radius:10px; padding:1.1rem 1.25rem; background:var(--bg-card);">
        <h4 style="font-weight:700; margin-bottom:0.4rem;">A node back into Trooth</h4>
        <p style="font-size:0.92rem; color:var(--text-muted); margin:0;">
          The more interesting direction. We never publish an accuracy number without naming an
          independent, settleable anchor, which is why only a handful of sources can carry one.
          KouroB's <code>submit_outcome</code> with <code>source: reality</code> is exactly that
          mechanism. Settled outcomes flowing back through it are anchors, and anchors are the
          scarcest input this benchmark has.
        </p>
      </div>
    </div>

    <p style="font-size:0.9rem; color:var(--text-subtle); margin-bottom:1rem;">
      Neither integration is built yet. Both are described here as intent, not as shipped work.
    </p>

    <p style="color:var(--text-muted); max-width:820px; margin-bottom:1.25rem;">
      Of the {demand.total} feed opportunities in our demand register,
      <strong>{demand.kourob_count}</strong> are cases where computing the change is mechanical
      but the customer needs the interpretation. That is a node's job and not a pipe's, and it
      is where the two would meet first.
    </p>

    <a href="https://alexchouck-hash.github.io/kourob/"
       style="display:inline-block; border:1px solid var(--primary); color:var(--primary); padding:0.55rem 1.1rem; border-radius:8px; text-decoration:none; font-weight:600;">
      Visit KouroB
    </a>
  </section>

  <section style="margin-bottom:3rem;">
    <h2 style="font-size:1.5rem; font-weight:700; margin-bottom:0.5rem;">2. 10xAnd</h2>
    <p style="color:var(--text-muted); max-width:760px;">
      The regulatory vertical: adverse events, recalls, inspections, and clearances. Planned for
      Phase 4. Nothing is built yet.
    </p>
  </section>

  <section style="margin-bottom:3rem;">
    <h2 style="font-size:1.5rem; font-weight:700; margin-bottom:0.75rem;">3. Agent clients</h2>
    <p style="color:var(--text-muted); margin-bottom:1rem; max-width:760px;">
      Anything speaking the Model Context Protocol reaches every source through one server and
      six tools, instead of one server per source. The server itself is Phase 1 and is not built
      yet, so these are targets rather than working integrations.
    </p>
    <div style="overflow-x:auto;">
      <table>
        <thead><tr><th>Client</th><th>Transport</th></tr></thead>
        <tbody>
          {clients.map(([name, transport]) => (
            <tr><td>{name}</td><td><code>{transport}</code></td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section style="margin-bottom:3rem;">
    <h2 style="font-size:1.5rem; font-weight:700; margin-bottom:0.5rem;">4. Frameworks and automation</h2>
    <p style="color:var(--text-muted); margin-bottom:0.75rem; max-width:760px;">
      For teams building their own agents: {frameworks}.
    </p>
    <p style="color:var(--text-muted); max-width:760px;">
      For turning a change into an action without writing code: {automation}. A revision alert
      that opens a ticket is worth more than one that opens a dashboard.
    </p>
  </section>

  <section style="margin-bottom:3rem;">
    <div style="display:flex; align-items:baseline; gap:0.75rem; flex-wrap:wrap; margin-bottom:0.5rem;">
      <h2 style="font-size:1.5rem; font-weight:700;">5. Open source UI outputs</h2>
      <span class="badge-tag">{ui.total_tools} tools, {ui.total_types} types</span>
    </div>
    <p style="color:var(--text-muted); margin-bottom:1.5rem; max-width:760px;">
      Trooth publishes JSON and CSV today, a Prometheus metrics endpoint at Phase 1, and Parquet
      at Phase 2. Every tool below consumes at least one of those. The
      <a href={p('/console')}>Trooth Console</a> is the zero-setup default; it is not the only
      option, and we would rather you used something you already run.
    </p>

    {ui.types.map((group: any) => (
      <div style="margin-bottom:1.75rem;">
        <h3 style="font-size:1.05rem; font-weight:700; margin-bottom:0.2rem; text-transform:capitalize;">
          {group.type.replace(/-/g, ' ')}
        </h3>
        <p style="font-size:0.9rem; color:var(--text-muted); margin-bottom:0.6rem;">{group.what}</p>
        <div style="display:flex; flex-wrap:wrap; gap:0.4rem;">
          {group.tools.map((tool: any) => (
            <span
              title={`${tool.license} | reads ${(tool.trooth_input || []).join(', ')}${tool.notes ? ' | ' + tool.notes : ''}`}
              style="border:1px solid var(--border); background:var(--bg-card); padding:0.25rem 0.65rem; border-radius:999px; font-size:0.85rem;"
            >{tool.name} <span style="color:var(--text-subtle); font-size:0.78rem;">{tool.license}</span></span>
          ))}
        </div>
      </div>
    ))}

    <p style="font-size:0.85rem; color:var(--text-subtle);">
      Licences are as commonly understood and are not verified the way catalog licences are.
      Check the terms before adopting one.
    </p>
  </section>

  <section style="margin-bottom:3rem;">
    <div style="display:flex; align-items:baseline; gap:0.75rem; flex-wrap:wrap; margin-bottom:0.5rem;">
      <h2 style="font-size:1.5rem; font-weight:700;">Connector registry</h2>
      <span class="badge-tag">{registry.by_status?.promoted ?? 0} live of {registry.total}</span>
    </div>
    <p style="color:var(--text-muted); margin-bottom:1.5rem; max-width:760px;">
      {registry.total} connectors we intend to support: {registry.by_kind?.mcp ?? 0} MCP servers
      and the rest data feeds. A connector becomes routable only after someone reads its licence
      from the source's own documentation and cites the URL. Until then it is listed here and
      nowhere else, and it carries no grade because nothing has been measured.
    </p>

    <h3 style="font-size:1rem; font-weight:700; margin-bottom:0.75rem;">Live now</h3>
    <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(250px, 1fr)); gap:0.85rem; margin-bottom:2rem;">
      {promoted.map((entry: any) => {
        return (
          <div style="border:1px solid var(--border); border-radius:10px; padding:1rem; background:var(--bg-card);">
            <a href={p(`/scorecards/${entry.id}`)} style="font-weight:700; display:block; margin-bottom:0.6rem;">{entry.name}</a>
            <Emblem subjectId={entry.id} size="sm" />
            <p style="font-size:0.85rem; color:var(--text-muted); margin-top:0.6rem;">{entry.why}</p>
          </div>
        );
      })}
    </div>

    <h3 style="font-size:1rem; font-weight:700; margin-bottom:0.75rem;">
      Next up: {priorityOne.length} priority one candidates
    </h3>
    <div style="display:flex; flex-wrap:wrap; gap:0.4rem;">
      {priorityOne.map((entry: any) => (
        <span
          id={entry.id}
          title={entry.why}
          style="border:1px dashed var(--border); padding:0.25rem 0.65rem; border-radius:999px; font-size:0.85rem; color:var(--text-muted);"
        >{entry.name}</span>
      ))}
    </div>
  </section>

  <!-- Modafied's emblem renderer. See src/components/Emblem.astro for why the emblem is a live
       reference rather than a file we keep. -->
  <script is:inline defer src={MODAFIED_EMBED_SRC}></script>
</Layout>
