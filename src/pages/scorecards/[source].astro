---
import Layout from '../../layouts/Layout.astro';
import { p } from '../../utils/paths';
import { MODAFIED_ORIGIN, MODAFIED_EMBED_SRC, MODAFIED_METHOD_URL, MODAFIED_TRACE_URL, modafiedCardUrl } from '../../utils/modafied';
import registry from '../../data/registry.json';

/**
 * Per-source page. Trooth publishes no scorecards (ADR-0014), so this page shows what Trooth
 * does know about a source (what it is, what it demonstrates, how it is licensed) and embeds
 * Modafied's live emblem for the grade. No grade is stored here or redrawn from its numbers.
 */

export async function getStaticPaths() {
  const entries = (registry.groups as any[])
    .flatMap((g) => g.entries ?? [])
    .filter((e: any) => e.status === 'promoted');
  return entries.map((entry: any) => ({
    params: { source: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;

const facts: [string, string][] = [
  ['Connector id', entry.id],
  ['Kind', entry.kind],
  ['Domain', entry.domain ?? 'unspecified'],
  ['Auth', entry.auth ?? 'unspecified'],
  ['Licence', entry.expected_terms ?? 'unspecified'],
  ['Licence status', entry.license_status],
];
---

<Layout
  title={`${entry.name} Scorecard`}
  description={`What Trooth knows about ${entry.name}, and the independent Modafied grade for it.`}
  activeNav="scorecards"
>
  <div style="margin-bottom: 1.5rem; font-size: 0.88rem; color: var(--text-subtle);">
    <a href={p('/scorecards')} style="color: var(--text-muted); text-decoration: none;">Scorecards</a>
    <span style="margin: 0 0.5rem;">/</span>
    <span>{entry.name}</span>
  </div>

  <div style="margin-bottom: 2rem;">
    <h1 style="font-size: 2.1rem; font-weight: 800; letter-spacing: -0.02em; margin-bottom: 0.5rem;">{entry.name}</h1>
    <p style="color: var(--text-muted); font-size: 1.05rem; max-width: 800px;">{entry.why}</p>
  </div>

  <section style="border: 1px solid var(--border); border-radius: 12px; padding: 1.5rem; margin-bottom: 2rem; background: var(--bg-card);">
    <div style="display: flex; align-items: baseline; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 0.9rem;">
      <h2 style="font-size: 1.2rem; font-weight: 700;">Independent grade</h2>
      <span class="badge-tag">Modafied</span>
    </div>

    <div style="margin-bottom: 1rem;"><span data-modafied={entry.id}></span></div>

    <p style="color: var(--text-muted); font-size: 0.95rem; margin-bottom: 0.75rem;">
      Fetched from <a href={MODAFIED_ORIGIN} target="_blank" rel="noopener">Modafied</a> when you
      loaded this page. Trooth keeps no copy and does no arithmetic on it. If the grade falls,
      the emblem above falls with it and we get no advance notice.
    </p>
    <div style="display: flex; gap: 1rem; flex-wrap: wrap; font-size: 0.9rem;">
      <a href={modafiedCardUrl(entry.id)} target="_blank" rel="noopener">Full card &rarr;</a>
      <a href={MODAFIED_METHOD_URL} target="_blank" rel="noopener">Method and band table</a>
      <a href={MODAFIED_TRACE_URL} target="_blank" rel="noopener">Resolve a trace id</a>
    </div>
  </section>

  <section style="margin-bottom: 2.5rem;">
    <h2 style="font-size: 1.2rem; font-weight: 700; margin-bottom: 0.9rem;">What Trooth knows</h2>
    <div style="overflow-x: auto;">
      <table>
        <tbody>
          {facts.map(([label, value]) => (
            <tr>
              <td style="white-space: nowrap; width: 30%;"><strong>{label}</strong></td>
              <td><code>{value}</code></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    {entry.notes && (
      <p style="color: var(--text-muted); font-size: 0.92rem; margin-top: 0.9rem;">{entry.notes}</p>
    )}
  </section>

  <section>
    <p style="color: var(--text-subtle); font-size: 0.88rem; line-height: 1.7;">
      Trooth decides what to route to; it does not decide how good it is. Those are different
      acts and they live in different repositories on purpose. See
      <a href={p('/connect')}>every connector we intend to support</a>, or read why the grading
      moved out in ADR-0014.
    </p>
  </section>

  <script is:inline defer src={MODAFIED_EMBED_SRC}></script>
</Layout>
