---
import Layout from '../layouts/Layout.astro';
import { p } from '../utils/paths';
import { MODAFIED_ORIGIN, MODAFIED_METHOD_URL, MODAFIED_TRACE_URL } from '../utils/modafied';

/**
 * Trooth publishes no scoring method, because it publishes no scores (ADR-0014).
 *
 * This page used to describe Trooth's own method. Keeping the route and explaining where the
 * method went is more useful than deleting it, and more honest than leaving a description of a
 * method we no longer run.
 */

const dimensions: [string, string][] = [
  ['Freshness lag', "How stale a value is when it is captured: the grader's clock minus the timestamp the source itself asserts. Reported as p50 and p95, because the tail is what breaks things."],
  ['Revision behaviour', 'How often a value already published for a fixed event time is changed afterwards. A high rate is a caching risk, not necessarily a fault: a source that revises may simply be careful.'],
  ['Correction latency', 'How long a wrong value stands before the source replaces it.'],
  ['Completeness by segment', 'What share of the expected records or fields are actually present, broken out by a segment the source defines. Ninety-nine percent nationally can still be sixty percent in the one state you care about.'],
  ['Schema stability', 'How often fields are renamed, retyped, or moved without notice. This is the dimension that breaks integrations at three in the morning.'],
  ['Internal consistency', 'Whether a single response contradicts itself: totals that do not sum, ranges inverted, timestamps ordered backwards.'],
];
---

<Layout
  title="Scoring Methodology"
  description="Trooth publishes no scores. The method behind every grade on this site is Modafied's, and it is public."
  activeNav="method"
>
  <div style="margin-bottom: 2rem;">
    <div style="display: flex; align-items: baseline; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 0.75rem;">
      <h1 style="font-size: 2.25rem; font-weight: 800; letter-spacing: -0.02em;">Scoring Methodology</h1>
      <span class="badge-tag">Published by Modafied</span>
    </div>
    <p style="color: var(--text-muted); font-size: 1.1rem; max-width: 820px;">
      Trooth does not score the sources it routes to, so the method that produces every grade on
      this site is not ours. It belongs to
      <a href={MODAFIED_ORIGIN} target="_blank" rel="noopener">Modafied</a>, it is public, and it
      is versioned independently of anything we ship.
    </p>
  </div>

  <section style="border: 1px solid var(--border); border-radius: 12px; padding: 1.5rem; margin-bottom: 2.5rem; background: var(--bg-card);">
    <h2 style="font-size: 1.2rem; font-weight: 700; margin-bottom: 0.75rem;">Why the method is not ours</h2>
    <p style="color: var(--text-muted); margin-bottom: 0.75rem;">
      We sell the pipe these feeds travel through. A method written by the company selling you the
      pipe is discounted by any serious reader, so writing one was worth less than not writing one.
    </p>
    <p style="color: var(--text-muted); margin-bottom: 0.75rem;">
      Modafied also does its own collecting, which matters more than it sounds. Freshness lag is
      the grader's clock minus the source's own event timestamp, so a grader working from
      somebody else's archive measures that supplier's scheduler rather than the source. An
      independent grade requires independent fetching, not just independent arithmetic.
    </p>
    <div style="display: flex; gap: 1rem; flex-wrap: wrap; font-size: 0.92rem;">
      <a href={MODAFIED_METHOD_URL} target="_blank" rel="noopener">Read the method &rarr;</a>
      <a href={MODAFIED_TRACE_URL} target="_blank" rel="noopener">Resolve a trace id</a>
      <a href={p('/scorecards')}>See the grades</a>
    </div>
  </section>

  <section style="margin-bottom: 2.5rem;">
    <h2 style="font-size: 1.4rem; font-weight: 700; margin-bottom: 0.5rem;">The six dimensions</h2>
    <p style="color: var(--text-muted); margin-bottom: 1.25rem; max-width: 820px;">
      Shared vocabulary between the two projects. The definitions are here so the words on our
      pages mean something; the measurements, the thresholds, and the band table are Modafied's.
    </p>
    <div style="display: flex; flex-direction: column; gap: 1.1rem;">
      {dimensions.map(([name, what]) => (
        <div style="border-left: 3px solid var(--primary); padding-left: 1.1rem;">
          <h3 style="font-size: 1.02rem; font-weight: 700; margin-bottom: 0.25rem;">{name}</h3>
          <p style="color: var(--text-muted); font-size: 0.94rem;">{what}</p>
        </div>
      ))}
    </div>
  </section>

  <section style="margin-bottom: 2.5rem;">
    <h2 style="font-size: 1.4rem; font-weight: 700; margin-bottom: 0.75rem;">Two rules that survive the handover</h2>
    <p style="color: var(--text-muted); margin-bottom: 0.75rem;">
      <strong>Accuracy is never published without naming its anchor.</strong> An accuracy number
      means nothing unless you can see what it was graded against, so any card carrying one names
      the independent, settleable reference on the same page. Most sources have no such anchor and
      therefore carry no accuracy figure at all.
    </p>
    <p style="color: var(--text-muted);">
      <strong>A missing measurement is never rendered as a zero.</strong> A dimension without
      enough samples reads <em>insufficient data</em>. Zero is a measurement; this is the absence
      of one, and collapsing the two is how benchmarks start lying.
    </p>
  </section>

  <section>
    <p style="color: var(--text-subtle); font-size: 0.88rem; line-height: 1.7;">
      Trooth funds Modafied, and every Modafied page says so. Trooth's own MCP server will be
      graded there by the same code once it exists.
    </p>
  </section>
</Layout>
